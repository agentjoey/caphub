DATABASE_URL=
DATABASE_URL_READONLY=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=caphub-objects
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
# Optional (worker). YouTube Data API v3 key, restricted to that API, for fetching video
# metadata (title/channel/duration/description) before a Gemini video analysis.
YOUTUBE_API_KEY=
# Optional (worker). Defaults to gemini-3.8-flash when unset.
GEMINI_VIDEO_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Public web origin used to build links back into the app (e.g. Telegram "already sent" replies).
# Defaults to https://caphub.agentjoey.ai when unset — only override for local/staging.
PUBLIC_BASE_URL=
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
# minimax | mixed | minimax_tavily
PIPELINE=minimax
VERDICT_AUTO_THRESHOLD=0.8
ANALYSIS_ENABLED=true
RETENTION_ENABLED=true
TELEGRAM_ENABLED=false
# Local spike report only: USD per million tokens (leave empty for cost "n/a")
SPIKE_PRICE_MINIMAX_IN=
SPIKE_PRICE_MINIMAX_OUT=
SPIKE_PRICE_DEEPSEEK_IN=
SPIKE_PRICE_DEEPSEEK_OUT=
